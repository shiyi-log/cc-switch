# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bridge.example.com
# DJANGO_DB_PATH=/data/db.sqlite3

# Bridge
BRIDGE_TOKEN=change-me-too
# Passphrase for upstream credential encryption (falls back to SECRET_KEY)
BRIDGE_ENCRYPTION_KEY=change-me-as-well

# The last 5% of every account's quota is never consumed.
BRIDGE_RESERVE_RATIO=0.05
# Extra headroom against stale upstream headers.
BRIDGE_SAFETY_MARGIN=0.005

# Third-party balance probes
BRIDGE_PROBE_TTL_SECONDS=300
BRIDGE_PROBE_TIMEOUT_SECONDS=8
BRIDGE_PROBE_REQUIRED=1

# Failover
BRIDGE_MAX_ATTEMPTS=3
BRIDGE_TIMEOUT_SECONDS=600

# Dynamic routing
BRIDGE_ROUTING_MODE=dynamic
BRIDGE_WEIGHT_COST=0.40
BRIDGE_WEIGHT_TTFT=0.30
BRIDGE_WEIGHT_SPEED=0.20
BRIDGE_WEIGHT_ERROR=0.10
BRIDGE_WEIGHT_PRIORITY=0.05
BRIDGE_STATS_MIN_SAMPLES=3
